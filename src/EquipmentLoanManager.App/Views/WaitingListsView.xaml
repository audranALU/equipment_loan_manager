<UserControl x:Class="EquipmentLoanManager.App.Views.WaitingListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Join a waiting list" Style="{StaticResource SectionHeading}" />

                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Label" Margin="0,0,0,14" />

                <TextBlock Text="Borrower" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Borrowers}" SelectedItem="{Binding SelectedBorrower}"
                          DisplayMemberPath="DisplayName" Margin="0,0,0,18" />

                <Button Content="Join waiting list" Command="{Binding JoinCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <TextBlock Margin="0,18,0,0" FontSize="12" Style="{StaticResource Muted}"
                           Text="Borrowers can only join when every item in the category is on loan." />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel request" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="Issue to next" Command="{Binding IssueCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0"
                                   Text="{Binding SelectedCategory.Label, StringFormat={}{0} queue}" />
                        <TextBlock Text="{Binding NextInLine}" FontSize="12" Style="{StaticResource Muted}" />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedEntry}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="Auto" />
                        <DataGridTextColumn Header="BORROWER ID" Binding="{Binding Borrower.Id}" Width="Auto" />
                        <DataGridTextColumn Header="NAME" Binding="{Binding Borrower.Name}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="All waiting lists" Style="{StaticResource SectionHeading}" />
                <DataGrid ItemsSource="{Binding Overview}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Label}" Width="Auto" />
                        <DataGridTextColumn Header="WAITING" Binding="{Binding Count}" Width="Auto" />
                        <DataGridTextColumn Header="ORDER (FRONT FIRST)" Binding="{Binding Order}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
