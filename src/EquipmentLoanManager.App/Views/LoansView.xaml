<UserControl x:Class="EquipmentLoanManager.App.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Borrow equipment" Style="{StaticResource SectionHeading}" />

                <TextBlock Text="Borrower" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Borrowers}" SelectedItem="{Binding SelectedBorrower}"
                          DisplayMemberPath="DisplayName" Margin="0,0,0,14" />

                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Label" Margin="0,0,0,18" />

                <Button Content="Borrow" Command="{Binding BorrowCommand}" Style="{StaticResource PrimaryButton}" />

                <TextBlock Margin="0,18,0,0" FontSize="12" Style="{StaticResource Muted}"
                           Text="Each borrower may hold up to two items, and only one per category." />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Return selected"
                            Command="{Binding ReturnCommand}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="Active loans" Style="{StaticResource SectionHeading}"
                               Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding ActiveLoans}" SelectedItem="{Binding SelectedLoan}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOAN ID" Binding="{Binding Id}" Width="Auto" />
                        <DataGridTextColumn Header="BORROWER" Binding="{Binding Borrower.DisplayName}" Width="*" />
                        <DataGridTextColumn Header="ITEM" Binding="{Binding Item.Id}" Width="Auto" />
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Item.CategoryName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Completed loans" Style="{StaticResource SectionHeading}" />
                <DataGrid ItemsSource="{Binding CompletedLoans}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOAN ID" Binding="{Binding Id}" Width="Auto" />
                        <DataGridTextColumn Header="BORROWER" Binding="{Binding Borrower.DisplayName}" Width="*" />
                        <DataGridTextColumn Header="ITEM" Binding="{Binding Item.Id}" Width="Auto" />
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Item.CategoryName}" Width="*" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
