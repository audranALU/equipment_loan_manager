<Window x:Class="EquipmentLoanManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EquipmentLoanManager.App.Views"
        Title="Equipment Loan Manager"
        Width="1200" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <UniformGrid DockPanel.Dock="Right" Rows="1" VerticalAlignment="Center">
                <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16,10" Width="124">
                    <StackPanel>
                        <TextBlock Text="Total items" Style="{StaticResource FieldLabel}" Margin="0" />
                        <TextBlock Text="{Binding TotalItems}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16,10" Width="124">
                    <StackPanel>
                        <TextBlock Text="Available" Style="{StaticResource FieldLabel}" Margin="0" />
                        <TextBlock Text="{Binding AvailableItems}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16,10" Width="124">
                    <StackPanel>
                        <TextBlock Text="Active loans" Style="{StaticResource FieldLabel}" Margin="0" />
                        <TextBlock Text="{Binding ActiveLoanCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource AccentHoverBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16,10" Width="124">
                    <StackPanel>
                        <TextBlock Text="Borrowers" Style="{StaticResource FieldLabel}" Margin="0" />
                        <TextBlock Text="{Binding BorrowerCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Equipment Loan Manager" Style="{StaticResource Title}" />
                <TextBlock Text="Simulate borrowing and returning campus equipment" Style="{StaticResource Muted}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,18,0,16" CornerRadius="10" Padding="16,11" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Inventory">
                <views:InventoryView DataContext="{Binding Inventory}" />
            </TabItem>
            <TabItem Header="Borrowers">
                <views:BorrowersView DataContext="{Binding Borrowers}" />
            </TabItem>
            <TabItem Header="Loans">
                <views:LoansView DataContext="{Binding Loans}" />
            </TabItem>
            <TabItem Header="Waiting lists">
                <views:WaitingListsView DataContext="{Binding WaitingLists}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
