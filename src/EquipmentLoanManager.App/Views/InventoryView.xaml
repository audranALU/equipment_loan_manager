<UserControl x:Class="EquipmentLoanManager.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Stock by category" Style="{StaticResource SectionHeading}" />
                <DataGrid ItemsSource="{Binding Summaries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Label}" Width="1.6*" />
                        <DataGridTextColumn Header="LIMIT" Binding="{Binding MaxCapacity}" Width="*" />
                        <DataGridTextColumn Header="CONFIGURED" Binding="{Binding Configured}" Width="1.3*" />
                        <DataGridTextColumn Header="AVAILABLE" Binding="{Binding Available}" Width="1.2*" />
                        <DataGridTextColumn Header="BORROWED" Binding="{Binding Borrowed}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Equipment items" Style="{StaticResource SectionHeading}" />
                <DataGrid ItemsSource="{Binding Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM ID" Binding="{Binding Id}" Width="Auto" />
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="*" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="Auto"
                                            ElementStyle="{StaticResource StatusCell}" />
                        <DataGridTextColumn Header="BORROWER" Binding="{Binding BorrowerName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
